step1:
readCounter --window 1000000 --quality 20 \
--chromosome "chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22,chrX,chrY" \
${sample}.bam >${sample}.wig

step2:
Rscript createPanelOfNormals.R --filelist "wig_file.txt" \
--gcWig "gc_hg38_1000kb.wig" \
--mapWig "map_hg38_1000kb.wig" \
--centromere "GRCh38.GCA_000001405.2_centromere_acen.txt" \
--outfile base_outfile_name

step3:
Rscript runIchorCNA.R --id ${sample} \
--WIG ${sample}.wig \
--ploidy "c(2)" \
--normal "c(0.5,0.6,0.7,0.8,0.9)" \
--maxCN 3 \
--gcWig gc_hg38_1000kb.wig \
--mapWig map_hg38_1000kb.wig \
--centromere GRCh38.GCA_000001405.2_centromere_acen.txt \
--normalPanel base_outfile_name_median.rds \
--includeHOMD False \
--chrs "c(1:22)" \
--chrTrain "c(1:22)" \
--estimateNormal True \
--estimatePloidy True \
--estimateScPrevalence FALSE \
--scStates "c()" \
--txnE 0.9999 \
--genomeBuild "hg38" \
--genomeStyle "UCSC" \
--txnStrength 10000 \
--outDir ichorCNA_result/
