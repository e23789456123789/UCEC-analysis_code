    idx_closest = np.argmin(np.abs(tpr - sens_v) + np.abs((1 - fpr) - spec_v))
    axes[0, 0].scatter(fpr[idx_closest], tpr[idx_closest], color='#d62728', s=60, zorder=5, 
                        label=f'Youden Point (Thresh={best_threshold:.3f})')
    
    axes[0, 0].set_xlabel('1 - Specificity (FPR)', fontsize=11)
    axes[0, 0].set_ylabel('Sensitivity (TPR)', fontsize=11)
    axes[0, 0].set_title('A. Receiver Operating Characteristic (ROC)', fontsize=12, weight='bold')
    axes[0, 0].legend(loc="lower right", frameon=True, fontsize=10)
    
    stats_box = (
