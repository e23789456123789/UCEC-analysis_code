        f"Sensitivity: {sens_v:.4f} (95% CI: {sens_l:.4f}-{sens_u:.4f})\n"
        f"Specificity: {spec_v:.4f} (95% CI: {spec_l:.4f}-{spec_u:.4f})\n"
        f"PPV: {ppv_v:.4f} (95% CI: {ppv_l:.4f}-{ppv_u:.4f})\n"
        f"NPV: {npv_v:.4f} (95% CI: {npv_l:.4f}-{npv_u:.4f})\n"
