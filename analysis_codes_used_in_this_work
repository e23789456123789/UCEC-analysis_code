def create_pipeline_space(model_name, trial):
    space = {
        "selector__l1_C": trial.suggest_float("selector__l1_C", 0.05, 5.0, log=True),
        "selector__fdr_alpha": trial.suggest_categorical("selector__fdr_alpha", [0.01, 0.05, 0.1])
    }
    
    if model_name == "xgboost":
        space.update({
            "clf__n_estimators": trial.suggest_int("clf__n_estimators", 50, 300),
            "clf__max_depth": trial.suggest_int("clf__max_depth", 3, 8),
            "clf__learning_rate": trial.suggest_float("clf__learning_rate", 0.01, 0.2),
            "clf__subsample": trial.suggest_float("clf__subsample", 0.6, 1.0),
        })
    elif model_name == "lightgbm":
        space.update({
            "clf__n_estimators": trial.suggest_int("clf__n_estimators", 50, 300),
            "clf__max_depth": trial.suggest_int("clf__max_depth", 3, 8),
            "clf__learning_rate": trial.suggest_float("clf__learning_rate", 0.01, 0.2),
            "clf__num_leaves": trial.suggest_int("clf__num_leaves", 15, 127), 
        })
    elif model_name == "randomforest":
        space.update({
            "clf__n_estimators": trial.suggest_int("clf__n_estimators", 100, 400),
            "clf__max_depth": trial.suggest_int("clf__max_depth", 3, 10),
        })
    elif model_name == "logistic":
        space.update({
            "clf__clf__C": trial.suggest_float("clf__clf__C", 1e-3, 1e1, log=True),
            "clf__clf__penalty": trial.suggest_categorical("clf__clf__penalty", ["l1", "l2"]),
        })
    return space

def run_optuna_for_file(file_path, output_base_dir):
    df = pd.read_csv(file_path)
    file_name = os.path.splitext(os.path.basename(file_path))[0]
    out_dir = os.path.join(output_base_dir, f"{file_name}_results")
    os.makedirs(out_dir, exist_ok=True)
    
    all_features = [c for c in df.columns if c not in ["Sample_ID", "Group", "Split"]]
    
    train_df = df[df["Split"] == "Train"]
    test_df = df[df["Split"] == "Test"]
    
    X_train = train_df[all_features]
    y_train = train_df["Group"].map({"Tumor": 1, "Normal": 0}).values
    X_test = test_df[all_features]
    y_test = test_df["Group"].map({"Tumor": 1, "Normal": 0}).values
    
    n_normal = np.sum(y_train == 0)
    n_tumor = np.sum(y_train == 1)
    scale_weight = float(n_normal / n_tumor) if n_tumor > 0 else 1.0
    
    def get_base_pipeline(m_name, scale_pos_weight=1.0):
        imputer = DataFrameImputer(ignore_cols=['Batch'])
        batch_corrector = PipelineBatchCorrector(batch_col='Batch')
        selector = PipelineStrictFeatureSelector(fdr_alpha=0.05, top_n_fallback=100, l1_C=0.5)
        if m_name == "xgboost":
            return Pipeline([('imputer', imputer), ('batch_corrector', batch_corrector), ('selector', selector), ('clf', XGBClassifier(scale_pos_weight=scale_pos_weight, eval_metric="logloss", verbosity=0, random_state=SEED, n_jobs=1))])
        elif m_name == "lightgbm":
            return Pipeline([('imputer', imputer), ('batch_corrector', batch_corrector), ('selector', selector), ('clf', LGBMClassifier(class_weight='balanced', verbose=-1, random_state=SEED, n_jobs=1))])
        elif m_name == "randomforest":
            return Pipeline([('imputer', imputer), ('batch_corrector', batch_corrector), ('selector', selector), ('clf', RandomForestClassifier(class_weight='balanced', random_state=SEED, n_jobs=1))])
        elif m_name == "logistic":
            return Pipeline([
                ('imputer', imputer), ('batch_corrector', batch_corrector), ('selector', selector), 
                ('clf', Pipeline([('scaler', StandardScaler()), ('clf', LogisticRegression(solver="liblinear", class_weight='balanced', random_state=SEED))]))
            ])
            
    all_models_metrics = {}
    best_cv_auc = -1
    best_model_name = None
    best_pipeline_params = None
    
    for model_name in ["xgboost", "lightgbm", "randomforest", "logistic"]:
        base_pipe = get_base_pipeline(model_name, scale_pos_weight=scale_weight)
        
        def objective(trial):
            params = create_pipeline_space(model_name, trial)
            pipe = clone(base_pipe)
            pipe.set_params(**params)
            cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)
            scores = cross_val_score(pipe, X_train, y_train, scoring="roc_auc", cv=cv, n_jobs=-1)
            return scores.mean()
            
        study = optuna.create_study(direction="maximize", sampler=TPESampler(seed=SEED))
        study.optimize(objective, n_trials=OPTUNA_TRIALS)
        
        all_models_metrics[model_name] = {
            "best_params": study.best_params,
            "cv_auc": float(study.best_value),
            "valid_auc": float(study.best_value)
        }
        
        if study.best_value > best_cv_auc:
            best_cv_auc = study.best_value
            best_model_name = model_name
            best_pipeline_params = study.best_params
            
    final_pipeline = get_base_pipeline(best_model_name, scale_pos_weight=scale_weight)
    final_pipeline.set_params(**best_pipeline_params)
    final_pipeline.fit(X_train, y_train)
    
    cv_threshold = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)
    y_train_oof_proba = cross_val_predict(final_pipeline, X_train, y_train, cv=cv_threshold, method="predict_proba", n_jobs=-1)[:, 1]
    
    fpr_tr, tpr_tr, th_tr = roc_curve(y_train, y_train_oof_proba)
    youden_tr = tpr_tr - fpr_tr
    best_thresh_idx = np.argmax(youden_tr)
    best_threshold = float(th_tr[best_thresh_idx])
    
    if best_threshold >= 1.0 or best_threshold <= 0.0 or np.isnan(best_threshold):
        best_threshold = 0.5
        
    features_without_batch = [c for c in all_features if c != 'Batch']
    passed_idx = final_pipeline.named_steps['selector'].selected_features_idx_
    final_chosen_features = [features_without_batch[i] for i in passed_idx]
    
    y_proba = final_pipeline.predict_proba(X_test)[:, 1]
    y_pred = (y_proba >= best_threshold).astype(int)
    test_auc = roc_auc_score(y_test, y_proba)
    
    plot_and_save_visualizations(train_df, final_chosen_features, y_test, y_proba, y_pred, best_threshold, out_dir, file_name)
    
    output_config = {
        "selected_features": final_chosen_features,
        "optimized_threshold": best_threshold,
        "models_metrics": all_models_metrics
    }
    with open(os.path.join(out_dir, "all_models_best_params.json"), "w") as f:
        json.dump(output_config, f, indent=4)
        
    pd.DataFrame(classification_report(y_test, y_pred, output_dict=True)).to_csv(os.path.join(out_dir, ".csv"))
    pd.DataFrame(confusion_matrix(y_test, y_pred)).to_csv(os.path.join(out_dir, ".csv"))
    
    final_pipeline.selected_features_ = final_chosen_features
    final_pipeline.optimized_threshold_ = best_threshold
    joblib.dump(final_pipeline, os.path.join(out_dir, "global_best_pipeline.pkl"))
    
    return {"file": file_name, "best_model": best_model_name, "valid_auc": best_cv_auc, "test_auc": test_auc}

