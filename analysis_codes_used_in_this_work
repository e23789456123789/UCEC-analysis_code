class DataFrameImputer(BaseEstimator, TransformerMixin):
    def __init__(self, ignore_cols=['Batch']):
        self.ignore_cols = ignore_cols
        self.means_ = {}
        
    def fit(self, X, y=None):
        if not isinstance(X, pd.DataFrame):
            X = pd.DataFrame(X)
        numeric_cols = [c for c in X.columns if c not in self.ignore_cols]
        self.means_ = X[numeric_cols].mean().to_dict()
        return self
        
    def transform(self, X):
        if not isinstance(X, pd.DataFrame):
            X = pd.DataFrame(X)
        X_trans = X.copy()
        for col, mean_val in self.means_.items():
            if col in X_trans.columns and X_trans[col].isnull().any():
                X_trans[col] = X_trans[col].fillna(mean_val)
        return X_trans

class PipelineBatchCorrector(BaseEstimator, TransformerMixin):
    def __init__(self, batch_col='Batch'):
        self.batch_col = batch_col
        self.means_ = {}
        self.stds_ = {}
        self.fallback_mean_ = None
        self.fallback_std_ = None
        self.feature_cols_ = None
        
    def fit(self, X, y=None):
        if not isinstance(X, pd.DataFrame):
            X = pd.DataFrame(X)
        self.feature_cols_ = [c for c in X.columns if c != self.batch_col]
        
        self.fallback_mean_ = X[self.feature_cols_].mean()
        self.fallback_std_ = X[self.feature_cols_].std().replace(0, 1e-8)
        
        for batch_id, group in X.groupby(self.batch_col):
            self.means_[batch_id] = group[self.feature_cols_].mean()
            self.stds_[batch_id] = group[self.feature_cols_].std().replace(0, 1e-8)
        return self
        
    def transform(self, X):
        if not isinstance(X, pd.DataFrame):
            X = pd.DataFrame(X)
        X_trans = X.copy()
        
        for batch_id, group in X.groupby(self.batch_col):
            idx = group.index
            if batch_id in self.means_:
                b_mean = self.means_[batch_id]
                b_std = self.stds_[batch_id]
            else:
                if len(group) > 1:
                    b_mean = group[self.feature_cols_].mean()
                    b_std = group[self.feature_cols_].std().replace(0, 1e-8)
                else:
                    b_mean = self.fallback_mean_
                    b_std = self.fallback_std_
                
            X_trans.loc[idx, self.feature_cols_] = (X.loc[idx, self.feature_cols_] - b_mean) / b_std
            
        return X_trans.drop(columns=[self.batch_col])

class PipelineStrictFeatureSelector(BaseEstimator, TransformerMixin):
    def __init__(self, fdr_alpha=0.05, top_n_fallback=100, l1_C=0.5):
        self.fdr_alpha = fdr_alpha
        self.top_n_fallback = top_n_fallback
        self.l1_C = l1_C
        self.selected_features_idx_ = None
        
    def fit(self, X, y):
        X_arr = X.values if isinstance(X, pd.DataFrame) else np.asarray(X)
        y_arr = np.asarray(y)
        
        tumor_mask = (y_arr == 1)
        normal_mask = (y_arr == 0)
        
        t_vals = X_arr[tumor_mask, :]
        n_vals = X_arr[normal_mask, :]
        
        p_values = np.zeros(X_arr.shape[1])
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            for i in range(X_arr.shape[1]):
                try:
                    _, p_values[i] = mannwhitneyu(t_vals[:, i], n_vals[:, i], nan_policy='omit')
                except ValueError:
                    p_values[i] = np.nan
                    
        valid_mask = ~np.isnan(p_values)
        valid_indices = np.where(valid_mask)[0]
        valid_p_values = p_values[valid_mask]
        
        if len(valid_indices) == 0:
            self.selected_features_idx_ = list(range(min(10, X_arr.shape[1])))
            return self
            
        reject, _, _, _ = multipletests(valid_p_values, alpha=self.fdr_alpha, method="fdr_bh")
        passed_t_idx = valid_indices[reject]
        
        if len(passed_t_idx) < 2:
            sorted_idx = np.argsort(valid_p_values)
            passed_t_idx = valid_indices[sorted_idx[:self.top_n_fallback]]
            
        X_passed = X_arr[:, passed_t_idx]
        X_passed_scaled = StandardScaler().fit_transform(X_passed)
        
        lr = LogisticRegression(
            penalty="l1", solver="liblinear", C=self.l1_C, 
            class_weight="balanced", random_state=SEED, max_iter=500
        )
        lr.fit(X_passed_scaled, y_arr)
        
        coefs = lr.coef_[0]
        non_zero_local_idx = np.where(coefs != 0)[0]
        
        if len(non_zero_local_idx) < 2:
            self.selected_features_idx_ = passed_t_idx[:10].tolist()
        else:
            self.selected_features_idx_ = passed_t_idx[non_zero_local_idx].tolist()
            
        return self
        
    def transform(self, X):
        X_arr = X.values if isinstance(X, pd.DataFrame) else np.asarray(X)
        return X_arr[:, self.selected_features_idx_]

def clean_and_align_all_matrices():
    df_ref = pd.read_csv(".csv").drop_duplicates(subset=["Sample_ID"])
    core_samples = set(df_ref["Sample_ID"].tolist())
    
    group_map = {}
    batch_map = {}
    for _, row in df_ref.iterrows():
        s_id = row["Sample_ID"]
        val_lower = str(row["Sample Type"]).lower().strip()
        group_map[s_id] = "Tumor" if val_lower in ["tumor", "cancer", "case"] else "Normal"
        batch_map[s_id] = "Batch_ZG" if str(s_id).startswith("ZG") else "Batch_CGP_PGD"
    
    sample_list = sorted(list(core_samples))
    
    train_samples = [s for s in sample_list if batch_map[s] == "Batch_ZG"]
    test_samples = [s for s in sample_list if batch_map[s] == "Batch_CGP_PGD"]
    
    split_map = {s: "Train" for s in train_samples}
    split_map.update({s: "Test" for s in test_samples})
    
    cleaned_files_registry = {}
    if os.path.exists(".tsv"):
        cleaned_files_registry[".csv"] = pd.read_csv(".tsv", sep='\t', index_col=0).T.reset_index().rename(columns={"index": "Sample_ID"})
    if os.path.exists(".csv"):
        cleaned_files_registry[".csv"] = pd.read_csv(".csv").rename(columns={"id": "Sample_ID"}).drop(columns=["type"], errors="ignore")
    if os.path.exists(".csv"):
        cleaned_files_registry[".csv"] = pd.read_csv(".csv").rename(columns={"WhichSample": "Sample_ID"}).drop(columns=["WhichGroup"], errors="ignore")
    if os.path.exists(".csv"):
        cleaned_files_registry[".csv"] = pd.read_csv(".csv").rename(columns={"WhichSample": "Sample_ID"}).drop(columns=["WhichGroup"], errors="ignore")
    if os.path.exists(".csv"):
        cleaned_files_registry[".csv"] = pd.read_csv(".csv").drop(columns=["Sample Type"], errors="ignore")
    if os.path.exists(".csv") and os.path.exists(".csv") and os.path.exists(".csv"):
        df_amp = pd.read_csv(".csv").rename(columns={"Unnamed: 0": "Sample_ID"}).drop(columns=["Type"], errors="ignore")
        df_mean = pd.read_csv(".csv").rename(columns={"Unnamed: 0": "Sample_ID"}).drop(columns=["Type"], errors="ignore")
        df_cent = pd.read_csv(".csv").rename(columns={"Unnamed: 0": "Sample_ID"}).drop(columns=["Type"], errors="ignore")
        for col in df_amp.columns:
            if col != "Sample_ID": df_amp = df_amp.rename(columns={col: f"Griffin_Amp_{col}"})
        for col in df_mean.columns:
            if col != "Sample_ID": df_mean = df_mean.rename(columns={col: f"Griffin_Mean_{col}"})
        for col in df_cent.columns:
            if col != "Sample_ID": df_cent = df_cent.rename(columns={col: f"Griffin_Cent_{col}"})
        cleaned_files_registry["matrix_griffin.csv"] = pd.merge(pd.merge(df_amp, df_mean, on="Sample_ID"), df_cent, on="Sample_ID")
    
    aligned_output_paths = []
    os.makedirs("aligned_clean_matrices", exist_ok=True)
    
    for filename, df_mat in cleaned_files_registry.items():
        df_mat = df_mat.drop_duplicates(subset=["Sample_ID"])
        df_mat = df_mat[df_mat["Sample_ID"].isin(sample_list)].copy()
        
        df_mat["Group"] = df_mat["Sample_ID"].map(group_map)
        df_mat["Split"] = df_mat["Sample_ID"].map(split_map)
        df_mat["Batch"] = df_mat["Sample_ID"].map(batch_map)
        
        feat_cols = [c for c in df_mat.columns if c not in ["Sample_ID", "Group", "Split", "Batch"]]
        ordered_cols = ["Sample_ID", "Group", "Split", "Batch"] + feat_cols
        
        df_final = df_mat.set_index("Sample_ID").loc[sample_list].reset_index()[ordered_cols]
        out_p = os.path.join("aligned_clean_matrices", f"aligned_final_selected_{filename}")
        df_final.to_csv(out_p, index=False)
        aligned_output_paths.append(out_p)
        
    return aligned_output_paths

def calculate_metric_ci(y_true, y_pred, y_proba, metric_type="auc"):
    y_true = np.asarray(y_true)
    y_pred = np.asarray(y_pred)
    y_proba = np.asarray(y_proba)
    
    if metric_type == "auc":
        auc_val = roc_auc_score(y_true, y_proba)
        return auc_val, np.nan, np.nan
        
    cm = confusion_matrix(y_true, y_pred)
    tn, fp, fn, tp = cm.ravel()
    
    if metric_type == "sensitivity":
        count, nobs = tp, tp + fn
    elif metric_type == "specificity":
        count, nobs = tn, tn + fp
    elif metric_type == "ppv":
        count, nobs = tp, tp + fp
    elif metric_type == "npv":
        count, nobs = tn, tn + fn
    else:
        raise ValueError("unclear_issue")
        
    if nobs == 0:
        return 0.0, 0.0, 0.0
        
    val = count / nobs
    lower, upper = proportion_confint(count, nobs, alpha=0.05, method="wilson")
    return val, lower, upper

def plot_and_save_visualizations(df_train, chosen_features, y_test, y_proba, y_pred, best_threshold, out_dir, file_name):
    if len(chosen_features) > 0:
        plt.figure(figsize=(11, 7))
        train_feat = df_train[chosen_features + ["Batch", "Group"]].copy()
        for col in chosen_features:
            for b_id, grp in train_feat.groupby("Batch"):
                train_feat.loc[grp.index, col] = (grp[col] - grp[col].mean()) / (grp[col].std() + 1e-8)
        train_feat = train_feat.sort_values(by="Group")
        heatmap_data = train_feat[chosen_features].T
        v_min, v_max = np.percentile(heatmap_data.values, [2, 98])
        
        g = sns.clustermap(
            heatmap_data, cmap="RdYlBu_r", col_cluster=False, 
            row_cluster=True if len(chosen_features) > 1 else False,
            vmin=v_min, vmax=v_max, xticklabels=False, yticklabels=True,
            cbar_kws={'label': 'Batch-Corrected Value (Z-score)'}, figsize=(11, 7)
        )
        g.fig.suptitle(f"Selected Top Features Clustering Heatmap: {file_name}", fontsize=13, y=1.02)
        g.savefig(os.path.join(out_dir, "selected_features_expression_heatmap.pdf"))
        plt.close('all')
        
    fig, axes = plt.subplots(2, 2, figsize=(14, 13))
    
    auc_v, _, _ = calculate_metric_ci(y_test, y_pred, y_proba, "auc")
    sens_v, sens_l, sens_u = calculate_metric_ci(y_test, y_pred, y_proba, "sensitivity")
    spec_v, spec_l, spec_u = calculate_metric_ci(y_test, y_pred, y_proba, "specificity")
    ppv_v, ppv_l, ppv_u = calculate_metric_ci(y_test, y_pred, y_proba, "ppv")
    npv_v, npv_l, npv_u = calculate_metric_ci(y_test, y_pred, y_proba, "npv")
    f1_v = f1_score(y_test, y_pred)
    
